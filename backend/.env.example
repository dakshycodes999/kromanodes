# KromaNodes Backend Configuration Template

# 1. Server settings
PORT=3000
NODE_ENV=development
JWT_SECRET=generate_a_random_32_character_string_here

# 2. CORS URL settings (adjust if running inside Codespaces)
# In local development:
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
# In Codespaces (example):
# FRONTEND_URL=https://username-codespace-8080.app.github.dev
# BACKEND_URL=https://username-codespace-3000.app.github.dev

# 3. Discord Application Client settings (Get from https://discord.com/developers)
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret

# 4. Supabase Database keys (Get from Settings -> API)
SUPABASE_URL=https://your_supabase_project_reference.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 5. Pterodactyl Panel settings (Required for game node actions)
PTERODACTYL_URL=https://panel.yourdomain.com
PTERODACTYL_APPLICATION_KEY=ptla_your_application_api_key_from_panel
PTERODACTYL_CLIENT_KEY=ptlc_your_client_api_key_from_account_settings
